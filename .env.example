# Flask
SECRET_KEY=your-very-long-random-secret-key-here
FLASK_DEBUG=false

# AWS Configuration (use IAM instance role in production, never hardcode keys)
AWS_REGION=ap-south-1

# DynamoDB Table Names
PATIENTS_TABLE=MedTrack_Patients
DOCTORS_TABLE=MedTrack_Doctors
APPOINTMENTS_TABLE=MedTrack_Appointments
DIAGNOSIS_REPORTS_TABLE=MedTrack_DiagnosisReports

# SNS Topic ARN for notifications
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:YOUR_ACCOUNT_ID:MedTrackNotifications

# Admin secret code required to register a new doctor account via /doctor/register
ADMIN_SECRET=your-admin-secret-here
